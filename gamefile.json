{
  "name": "Warhammer 40,000 TCG (nombre provisional)",
  "deckBuilding": {
    "mainFilters": [
      "type",
      "cost"
    ],
    "formats": [
      {
        "title": "Construido",
        "gameplay": "Principal",
        "deckRuleset": "Mazo de 50"
      }
    ],
    "deckRulesets": {
      "Mazo de 50": {
        "general": {
          "min": 50,
          "max": 50
        }
      }
    }
  },
  "gameplay": {
    "Principal": {
      "mulligan": {
        "startingHandSize": 5
      },
      "newTurn": {
        "sharedTurn": false,
        "drawOnStart": true
      },
      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            {
              "section": "Board"
            },
            {
              "section": "Scripts"
            }
          ]
        },
        "sectionsDict": {
          "Board": {
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER",
            "displayedTitle": "Tablero"
          },
          "Scripts": {
            "type": "custom",
            "defaultValue": {
              "status": "Preparando el Núcleo...",
              "coreCreated": false
            },
            "blueprint": {
              "type": "div",
              "children": "{{ game.data.Scripts.status }}"
            },
            "events": {
              "onStart": "game.data.Scripts.status = 'Preparando el Núcleo...'; game.data.Scripts.coreCreated = false;",
              "onPlayersDeckPicked": "if (!game.data.Scripts.coreCreated) { game.data.Scripts.coreCreated = true; game.data.Scripts.status = 'Preparando el Núcleo...'; try { await functions.createCard('yggdr-votann', 'Board'); game.data.Scripts.status = ''; } catch (error) { game.data.Scripts.coreCreated = false; game.data.Scripts.status = 'No se pudo crear el Núcleo. Revisa el registro de la partida.'; functions.chatLog('Error al crear Yggdr-Votann: ' + String(error)); } }"
            }
          }
        }
      }
    }
    "cards": {
    "dataUrl": "https://raw.githubusercontent.com/AlonsoElGofres/warhammer40k-tcg/main/cards.json",
    "cardBack": "https://raw.githubusercontent.com/AlonsoElGofres/warhammer40k-tcg/main/card-back.png"
  }
}
