{
  "name": "Warhammer 40,000 TCG (nombre provisional)",
  "deckBuilding": {
    "mainFilters": [
      "type",
      "cost"
    ],
    "formats": [
      {
        "title": "Construido",
        "gameplay": "Principal",
        "deckRuleset": "Mazo de 50"
      }
    ],
    "deckRulesets": {
      "Mazo de 50": {
        "general": {
          "min": 50,
          "max": 50
        },
        "categories": [
          {
            "category": "Núcleo",
            "min": 1,
            "max": 1,
            "maxPerCard": 1
          }
        ]
      }
    }
  },
  "gameplay": {
    "Principal": {
      "beforeGameStart": {
        "boardCardSelection": [
          {
            "category": "Núcleo",
            "min": 1,
            "max": 1
          }
        ]
      },
      "mulligan": {
        "startingHandSize": 5
      },
      "newTurn": {
        "sharedTurn": false,
        "drawOnStart": true
      },
      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            {
              "section": "Board"
            }
          ]
        },
        "categoriesAlreadyOnBoard": [
          "Núcleo"
        ],
        "sectionsDict": {
          "Board": {
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER",
            "displayedTitle": "Tablero"
          },
          "Núcleo": {
            "isHidden": "yes",
            "height": "SMALL",
            "alignment": "DECK",
            "displayedTitle": "Núcleo seleccionado",
            "noQuickActions": true
          },
          "Scripts": {
            "type": "custom",
            "events": {
              "onPlayersBoardCardSelected": "for (const card of cards?.['Núcleo'] ?? []) { if (card.owner === game.playerId) { await functions.moveCard(card, 'Board'); } } await functions.repositionCards();"
            }
          }
        }
      }
    }
  },
  "cards": {
    "dataUrl": "https://raw.githubusercontent.com/AlonsoElGofres/warhammer40k-tcg/main/cards.json",
    "cardBack": "https://raw.githubusercontent.com/AlonsoElGofres/warhammer40k-tcg/main/card-back.png"
  }
}
